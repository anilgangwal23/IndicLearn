rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function ownsProfile(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validProfile() {
      let data = request.resource.data;
      return data.keys().hasAll([
          'schemaVersion', 'displayName', 'sourceLanguage', 'targetLanguage',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'schemaVersion', 'displayName', 'sourceLanguage', 'targetLanguage',
          'createdAt', 'updatedAt'
        ])
        && data.schemaVersion == 1
        && data.displayName is string
        && data.displayName.size() > 0 && data.displayName.size() <= 80
        && data.sourceLanguage is string && data.sourceLanguage.size() > 0
        && data.sourceLanguage.size() <= 35
        && data.targetLanguage is string && data.targetLanguage.size() > 0
        && data.targetLanguage.size() <= 35
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }

    match /profiles/{userId} {
      allow get: if ownsProfile(userId);
      allow list: if false;
      allow create: if ownsProfile(userId) && validProfile()
        && request.resource.data.createdAt == request.time;
      allow update: if ownsProfile(userId) && validProfile()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'sourceLanguage', 'targetLanguage', 'updatedAt']);
      allow delete: if ownsProfile(userId);

      match /progress/{scenarioId} {
        function validProgress() {
          let data = request.resource.data;
          return data.keys().hasAll([
              'schemaVersion', 'completedLevelIds', 'updatedAt'
            ])
            && data.keys().hasOnly([
              'schemaVersion', 'completedLevelIds', 'updatedAt'
            ])
            && data.schemaVersion == 1
            && data.completedLevelIds is list
            && data.completedLevelIds.size() <= 12
            && data.updatedAt == request.time;
        }

        allow get, list: if ownsProfile(userId);
        allow create: if ownsProfile(userId) && validProgress();
        allow update: if ownsProfile(userId)
          && validProgress()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['completedLevelIds', 'updatedAt'])
          && request.resource.data.completedLevelIds
            .hasAll(resource.data.completedLevelIds);
        allow delete: if false;
      }
    }
  }
}